# Calinfco Water Purifier E-Commerce Monorepo Environment Variables
# Copy to .env or target app .env files and update with your local/testing configuration.
# NEVER COMMIT REAL SECRETS OR PRODUCTION API KEYS TO VERSION CONTROL.

# Firebase Public Configuration
EXPO_PUBLIC_FIREBASE_API_KEY="your-expo-firebase-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="calinfco-water-purifier.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="calinfco-water-purifier"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="calinfco-water-purifier.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
EXPO_PUBLIC_FIREBASE_APP_ID="1:123456789012:android:abcdef123456"

NEXT_PUBLIC_FIREBASE_API_KEY="your-next-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="calinfco-water-purifier.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="calinfco-water-purifier"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="calinfco-water-purifier.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# n8n Automation Webhooks
N8N_WEBHOOK_BASE_URL="http://localhost:5678/webhook"
N8N_ORDER_CREATED_WEBHOOK_PATH="order-created"
N8N_SERVICE_REQUEST_WEBHOOK_PATH="service-dispatch"
N8N_FILTER_REMINDER_WEBHOOK_PATH="filter-reminder"

# App Ports & URLs
NEXT_PUBLIC_ADMIN_PORT="3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
