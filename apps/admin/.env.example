# Calinfco Admin Next.js Application Environment Variables
# Copy to .env.local for local development. Do NOT commit real credentials.

# Firebase Web Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your-next-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="calinfco-water-purifier.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="calinfco-water-purifier"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="calinfco-water-purifier.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Server-side Firebase Admin (Service Account - DO NOT COMMIT REAL KEYS)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@calinfco-water-purifier.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Razorpay Payment Gateway (Server & Client)
RAZORPAY_KEY_ID="rzp_test_calinfco_sample"
RAZORPAY_KEY_SECRET="sample_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_calinfco_sample"

# Automation Webhooks
N8N_WEBHOOK_URL="http://localhost:5678/webhook"

# EmailJS Service (Documented Free-Tier Email Provider)
# Sign up at https://emailjs.com - free tier gives 200 emails/month
EMAILJS_SERVICE_ID="your_emailjs_service_id"
EMAILJS_TEMPLATE_ID="your_emailjs_template_id"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key" # Optional AccessToken for restricted REST API

# TextBee SMS Gateway (Documented Free-Tier Android Gateway)
# Sign up at https://textbee.dev or install the TextBee Android app
# NEVER expose TEXTBEE_API_KEY in mobile/client-side code!
TEXTBEE_API_KEY="your_textbee_api_key"
TEXTBEE_DEVICE_ID="your_textbee_device_id"

# Firebase Cloud Messaging (FCM) & Expo Push Service
# Option A: Legacy FCM Server Key or Service Account credentials
FCM_SERVER_KEY="your_firebase_server_key_here"
# Option B: Expo Push Access Token (optional if using Expo push gateway)
EXPO_ACCESS_TOKEN=""

# App
PORT="3000"
