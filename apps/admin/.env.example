# Calinfco Admin Next.js Application Environment Variables
# Copy to .env.local for local development. Do NOT commit real credentials.

# Firebase Web Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your-next-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="calinfco-water-purifier.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="calinfco-water-purifier"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="calinfco-water-purifier.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Server-side Firebase Admin (Service Account - DO NOT LEAK)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@calinfco-water-purifier.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Automation Webhooks
N8N_WEBHOOK_URL="http://localhost:5678/webhook"

# App
PORT="3000"
