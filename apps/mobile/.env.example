# Calinfco Mobile Application (Expo / React Native)
# Copy this file to .env before starting the app.
# NEVER COMMIT REAL SECRETS TO VERSION CONTROL.

EXPO_PUBLIC_APP_NAME="Calinfco Water Purifiers"
EXPO_PUBLIC_APP_VERSION="1.0.0"

# Firebase Client SDK Configuration (Safe for public client app with Firestore Security Rules)
EXPO_PUBLIC_FIREBASE_API_KEY="your-expo-firebase-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="calinfco-water-purifier.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="calinfco-water-purifier"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="calinfco-water-purifier.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
EXPO_PUBLIC_FIREBASE_APP_ID="1:123456789012:android:abcdef123456"

# Backend & Automation Endpoints
EXPO_PUBLIC_ADMIN_API_URL="http://localhost:3000/api"
EXPO_PUBLIC_N8N_WEBHOOK_URL="http://localhost:5678/webhook"

# Expo / EAS Project Configuration (for Push Notifications)
# Get your project UUID from https://expo.dev
EXPO_PUBLIC_PROJECT_ID="your-expo-project-uuid-here"
