# Calinfco Operations - n8n Local Automation Environment Configuration
# COPY THIS FILE TO '.env' BEFORE STARTING DOCKER COMPOSE.
# NEVER COMMIT '.env' OR ACTUAL ENCRYPTION KEYS TO VERSION CONTROL.

# Required: Generate a 32+ character random hexadecimal key for encrypting credentials.
# In Windows PowerShell, generate one using:
#   [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
N8N_ENCRYPTION_KEY="replace_with_a_secure_random_key_min_32_chars"

# Timezone settings (defaulted to Indian Standard Time)
TZ="Asia/Kolkata"
GENERIC_TIMEZONE="Asia/Kolkata"

# Local Host & Port (Local-only binding 127.0.0.1:5678)
N8N_PORT="5678"
N8N_HOST="127.0.0.1"
N8N_PROTOCOL="http"

# Webhook configuration for local callbacks
WEBHOOK_URL="http://127.0.0.1:5678/"

# Optional API Credentials for Future Integrations (Fill in when ready)
# META_INSTAGRAM_ACCESS_TOKEN="placeholder_instagram_token"
# INSTAGRAM_ACCOUNT_ID="placeholder_instagram_account_id"
# OPENAI_API_KEY="placeholder_openai_api_key"
