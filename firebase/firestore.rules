rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isTechnician() {
      return isAuthenticated() && (
        request.auth.token.technician == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'technician'
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isTechnician());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Water Purifiers & Filter Catalog (Public read, Admin manage)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationReason', 'orderStatus']));
      allow delete: if isAdmin();
    }

    // Installation & Purifier Service Requests
    match /serviceRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.technicianId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() || isTechnician() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // AMC (Annual Maintenance Contract) Subscriptions
    match /amcSubscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Customer Water Quality / TDS Readings
    match /waterQualityLogs/{logId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin() || isTechnician());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    // Technician Directory & Roster
    match /technicians/{techId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
