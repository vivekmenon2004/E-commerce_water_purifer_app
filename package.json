{
  "name": "calinfco-water-purifier-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "build:admin": "npm --prefix apps/admin run build",
    "lint:admin": "npm --prefix apps/admin run lint",
    "lint:mobile": "npm --prefix apps/mobile run lint",
    "seed": "node scripts/seed-firestore.mjs",
    "seed:dry-run": "node scripts/seed-firestore.mjs --dry-run",
    "test:milestone": "node tests/verify-milestone.mjs",
    "test:shopping": "node tests/customer-shopping-test.mjs",
    "test:checkout": "node tests/checkout-and-services-test.mjs",
    "test:payment-flow": "node tests/milestone-test-payment-verification.mjs",
    "test:dealer": "node tests/dealer-features-test.mjs",
    "test:dealer-accounts": "node tests/milestone-dealer-accounts-verification.mjs"
  },
  "keywords": [
    "water-purifier",
    "e-commerce",
    "expo",
    "nextjs",
    "calinfco"
  ],
  "author": "Calinfco Team",
  "license": "UNLICENSED"
}
